# Copie para .streamlit/secrets.toml (local) ou cole em "Settings > Secrets" no Streamlit Community Cloud.
# NUNCA versione o secrets.toml.

SUPABASE_URL = "https://<seu-projeto>.supabase.co"
SUPABASE_ANON_KEY = "<anon / publishable key>"          # Project Settings > API

# Somente servidor (Streamlit Secrets nunca vai ao navegador). Necessária para criar supervisores.
SUPABASE_SERVICE_ROLE_KEY = "<service role key>"
