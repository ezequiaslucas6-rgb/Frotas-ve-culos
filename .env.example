# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/publishable key>

# NUNCA expor no navegador. Usada só no servidor (criar supervisores, cron de alertas).
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Segredo do cron diário de alertas (enviado como "Authorization: Bearer <CRON_SECRET>").
# Gere com: openssl rand -hex 32
CRON_SECRET=<string aleatória longa>

# Porta local (só 127.0.0.1) em que o container escuta; o Nginx publica no subdomínio.
FROTAS_PORTA=3010

# Leitura automática do cupom de abastecimento (opcional). Sem a chave, o lançamento é digitado
# à mão (as contas de desconto e preço por litro continuam automáticas).
# Chave gratuita em https://aistudio.google.com/apikey — fica só no servidor, nunca no celular.
GEMINI_API_KEY=
# Modelos em ordem de preferência (se um estourar o limite gratuito, usa o próximo).
GEMINI_MODELOS=gemini-flash-latest,gemini-flash-lite-latest

# Cadastro de motorista: CPF, WhatsApp e CNH obrigatórios (com dígitos verificadores).
# Desligado na fase de testes (só nome e e-mail; números fictícios aceitos). Para religar: 1
MOTORISTA_DADOS_OBRIGATORIOS=
