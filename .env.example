# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/publishable key>

# NUNCA expor no navegador. Usada só no servidor (criar supervisores, cron de alertas).
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Segredo do cron diário de alertas (enviado como "Authorization: Bearer <CRON_SECRET>").
# Gere com: openssl rand -hex 32
CRON_SECRET=<string aleatória longa>

# Porta local (só 127.0.0.1) em que o container escuta; o Nginx publica no subdomínio.
FROTAS_PORTA=3010
