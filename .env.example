# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon/publishable key>

# NUNCA expor no browser. Usada apenas em Server Actions/rotas (criar supervisores, cron).
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Segredo do cron diário de alertas (a Vercel envia como "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=<string aleatória longa>
